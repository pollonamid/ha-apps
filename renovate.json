{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "customManagers:dockerfileVersions"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "pip_requirements"
  ],
  "packageRules": [
    {
      "description": "Group the actions of the workflows",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Base images are pinned through renovate annotations",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "ubuntu",
        "ghcr.io/home-assistant/base-ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "Group the versions of the audio.cpp build",
      "matchPackageNames": [
        "0xShug0/audio.cpp",
        "m-abs/wyoming_audiocpp"
      ],
      "groupName": "audio.cpp build dependencies"
    }
  ],
  "ignorePaths": [
    "tests/e2e/.cache/**"
  ]
}
