#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Audio.cpp server
# ==============================================================================
# The server gets the speech-to-text model and the models of the text-to-speech
# family. A model of the family that is not on the disk is downloaded when it
# is used for the first time, the proxy in front of the server does it.
# ==============================================================================
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
set -euo pipefail

readonly APP_DIR="/app"
readonly CONFIG_DIR="/config"
readonly MODELS_DIR="/share/audio_cpp/models"
readonly SPEC_DIR="/app/model_specs"
readonly PORT="8099"
readonly TOKEN_FILE="/root/.cache/huggingface/token"
readonly HF_BASE_URL="https://huggingface.co"

mkdir -p "${CONFIG_DIR}" "${MODELS_DIR}"

# Read an option from the local options file. bashio::config would ask the
# Supervisor for the default of an empty option, which is not needed here.
option() {
    bashio::config "${1}" 2> /dev/null || true
}

speech_to_text_model="$(option 'speech_to_text_model')"
backend="$(option 'backend')"
threads="$(option 'threads')"
max_loaded_models="$(option 'max_loaded_models')"
tts_family="$(option 'tts_family')"
hf_token="$(option 'hf_token')"

if [[ -z "${speech_to_text_model}" || "${speech_to_text_model}" == "null" ]]; then
    speech_to_text_model="qwen3_asr_0_6b_q8_0"
fi
if [[ -z "${tts_family}" || "${tts_family}" == "null" ]]; then
    tts_family="pocket_tts"
fi

# The token is stored in a file, because the server reads it from there for
# every download. That way it also works for the models the web interface
# installs, not only for the ones downloaded here.
if [[ -n "${hf_token}" && "${hf_token}" != "null" ]]; then
    mkdir -p "$(dirname "${TOKEN_FILE}")"
    printf '%s' "${hf_token}" > "${TOKEN_FILE}"
    chmod 600 "${TOKEN_FILE}"
    bashio::log.info "Hugging Face token saved."
fi

# Keep the models inside /share so they survive an update. The server uses
# <binary directory>/models as its default models root.
if [[ ! -L /app/models ]]; then
    rm -rf /app/models
    ln -s "${MODELS_DIR}" /app/models
fi

# Find the model spec file that owns a model package id
resolve_spec() {
    local pkg="$1"
    local candidate
    for candidate in "${SPEC_DIR}"/*.json; do
        if jq -e --arg id "${pkg}" '.packages[]? | select(.id == $id)' "${candidate}" > /dev/null 2>&1; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

# Resolve a model package to its family and the path it is installed to. The
# model itself is not downloaded here, that happens in the background so that
# a slow download does not hold up the start of the app.
MODEL_FILE=""
MODEL_DIR=""
MODEL_FAMILY=""
resolve_model() {
    local pkg="$1"
    local spec_file
    local target_dir
    local file_name

    if ! spec_file="$(resolve_spec "${pkg}")"; then
        bashio::log.fatal "Unknown model '${pkg}'. Pick one of the models listed in the app options."
        exit 1
    fi

    target_dir="$(jq -r --arg id "${pkg}" '.packages[] | select(.id == $id) | .target_directory' "${spec_file}")"
    file_name="$(jq -r --arg id "${pkg}" '.packages[] | select(.id == $id) | .files[0] | split("/") | last' "${spec_file}")"
    MODEL_FAMILY="$(basename "${spec_file}" .json)"
    MODEL_DIR="${MODELS_DIR}/${target_dir}"
    MODEL_FILE="$(find "${MODEL_DIR}" -maxdepth 1 -name '*.gguf' -print -quit 2> /dev/null || true)"
    if [[ -z "${MODEL_FILE}" ]]; then
        # The model is not on disk yet, this is where it will land.
        MODEL_FILE="${MODEL_DIR}/${file_name}"
    fi
}

# The files of a package are installed relative to its target directory, with
# the strip_prefix removed from the front.
installed_files() {
    local pkg="$1"
    jq -r --arg id "${pkg}" '
        (.packages[] | select(.id == $id)) as $p
        | ($p.strip_prefix // "") as $sp
        | $p.files[]
        | if ($sp != "" and startswith($sp + "/")) then ltrimstr($sp + "/") else . end
    ' "$(resolve_spec "${pkg}")"
}

# Voice presets for models that ship voice embeddings, such as PocketTTS. They
# are taken from the model spec, so they are known before the model is
# downloaded. Embeddings that are not part of the package, such as a voice
# that was downloaded for a model without voices, are taken from the disk.
voice_presets() {
    local pkg="$1"
    local target_dir="$2"
    local result='{}'
    local relative
    local name
    while IFS= read -r relative; do
        case "${relative}" in
            embeddings/*.safetensors)
                name="$(basename "${relative}" .safetensors)"
                result="$(jq --arg n "${name}" --arg p "${target_dir}/${relative}" \
                    '. + {($n): {options: {voice_embedding_file: $p}}}' <<< "${result}")"
                ;;
        esac
    done < <(installed_files "${pkg}")
    while IFS= read -r relative; do
        name="$(basename "${relative}" .safetensors)"
        result="$(jq --arg n "${name}" --arg p "${relative}" \
            '. + {($n): {options: {voice_embedding_file: $p}}}' <<< "${result}")"
    done < <(find "${target_dir}/embeddings" -maxdepth 1 -name '*.safetensors' -print 2> /dev/null || true)
    printf '%s' "${result}"
}

# Run the model manager and log the download progress only every 5 percent,
# it prints a line for every chunk otherwise.
run_model_manager() {
    stdbuf -oL -eL "${APP_DIR}/audiocpp_model_manager" "$@" 2>&1 | awk '
        /^downloaded=[0-9]+ total=[0-9]+ / {
            downloaded = substr($1, 12) + 0
            total = substr($2, 7) + 0
            if (total > 0) {
                percent = int(downloaded * 100 / total)
                if (percent >= threshold) {
                    print
                    threshold = (int(percent / 5) + 1) * 5
                }
            }
            next
        }
        { print }
    '
}

# Download a model from the catalog when it is missing.
download_catalog_model() {
    local pkg="$1"
    local spec_file
    local target_dir
    local gguf

    if ! spec_file="$(resolve_spec "${pkg}")"; then
        return 1
    fi

    target_dir="$(jq -r --arg id "${pkg}" '.packages[] | select(.id == $id) | .target_directory' "${spec_file}")"
    gguf="$(find "${MODELS_DIR}/${target_dir}" -maxdepth 1 -name '*.gguf' -print -quit 2> /dev/null || true)"
    if [[ -n "${gguf}" ]]; then
        return 0
    fi

    bashio::log.info "Downloading model '${pkg}' into ${MODELS_DIR}. This can take a while."
    if run_model_manager install "${pkg}" --models-dir "${MODELS_DIR}"; then
        return 0
    fi

    # Hugging Face rejects public downloads with an invalid token, so
    # try again without it.
    if [[ -n "${hf_token}" && -f "${TOKEN_FILE}" ]]; then
        bashio::log.warning "The download failed, retrying without the Hugging Face token."
        mv "${TOKEN_FILE}" "${TOKEN_FILE}.disabled"
        run_model_manager install "${pkg}" --models-dir "${MODELS_DIR}"
        local status=$?
        mv "${TOKEN_FILE}.disabled" "${TOKEN_FILE}"
        if [[ "${status}" -ne 0 ]]; then
            bashio::log.error "Could not download the model '${pkg}'."
            return 1
        fi
        return 0
    fi

    bashio::log.error "Could not download the model '${pkg}'."
    return 1
}

resolve_model "${speech_to_text_model}"
asr_family="${MODEL_FAMILY}"
asr_path="${MODEL_FILE}"
pending_catalog_downloads=("${speech_to_text_model}")

# The models of the text-to-speech family. Every language of the family is
# served, the ones that are not on the disk are downloaded when they are used.
jq_program='
    split("\n") | map(select(length > 0)) | map(split("|"))
    | map({id: .[0], family: "pocket_tts", path: .[2], task: "tts", mode: "offline", lazy: true})
'
tts_models="$(/usr/local/bin/tts_family_models.sh "${tts_family}" | jq -R -s "${jq_program}")"

bashio::log.info "ASR model '${speech_to_text_model}' (${asr_family}) from ${asr_path}"
bashio::log.info "TTS family '${tts_family}' with $(jq 'length' <<< "${tts_models}") model(s)"

# Fall back to the CPU backend when no Vulkan device is available
if [[ "${backend}" == "vulkan" ]]; then
    if ! "${APP_DIR}/audiocpp_server" --list-devices 2> /dev/null | grep -q '^vulkan:'; then
        bashio::log.warning "No Vulkan device found, falling back to the CPU backend."
        backend="cpu"
    fi
fi

jq -n \
    --arg host "0.0.0.0" \
    --argjson port "${PORT}" \
    --arg backend "${backend}" \
    --argjson threads "${threads}" \
    --argjson max_loaded "${max_loaded_models}" \
    --arg asr_id "${speech_to_text_model}" \
    --arg asr_family "${asr_family}" \
    --arg asr_path "${asr_path}" \
    --argjson tts_models "${tts_models}" \
    '{
        host: $host,
        port: $port,
        backend: $backend,
        device: 0,
        threads: $threads,
        lazy_load: true,
        max_loaded_models: $max_loaded,
        ui: true,
        ui_management: true,
        models: (
            [{ id: $asr_id, family: $asr_family, path: $asr_path, task: "asr", mode: "offline", lazy: true }]
            + $tts_models
        )
    }' > "${CONFIG_DIR}/server.json"

# Download the models in the background. The server starts right away and
# loads a model on demand, so a slow download does not hold up the start of
# the app. The Supervisor allows an app 120 seconds to report that it started.
(
    for pkg in "${pending_catalog_downloads[@]}"; do
        download_catalog_model "${pkg}" || true
    done
) &

bashio::log.info "Starting audiocpp_server on port ${PORT} with the ${backend} backend."
bashio::log.info "Models are in ${MODELS_DIR}, the configuration is in ${CONFIG_DIR}."
# Line buffered, so the log of the server shows up right away and does not end
# up mixed up with the output of the other services.
exec stdbuf -oL -eL "${APP_DIR}/audiocpp_server" \
    --config "${CONFIG_DIR}/server.json" \
    --model-spec-override "${SPEC_DIR}"
