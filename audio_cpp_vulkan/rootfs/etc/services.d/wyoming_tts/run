#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Wyoming text-to-speech bridge
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
set -euo pipefail

readonly CONFIG_DIR="/config"
readonly MODELS_DIR="/share/audio_cpp/models"
readonly SPEC_DIR="/app/model_specs"
readonly APP_PORT="8099"
readonly TTS_PORT="11201"

export PYTHONPATH="/app/wyoming"

# bashio::config asks the Supervisor for the default of an empty option, which
# is not needed here.
option() {
    bashio::config "${1}" 2> /dev/null || true
}

if [[ "$(option 'enable_tts')" != "true" ]]; then
    bashio::log.info "Text-to-speech is disabled. Enable it in the app options to use the Wyoming TTS bridge."
    exec sleep infinity
fi

tts_model="$(option 'tts_model')"
tts_voice="$(option 'tts_voice')"
tts_language="$(option 'tts_language')"

# The language of the voice is reported to Home Assistant, so it can pick the
# engine for a pipeline. It is derived from the model when it is set to auto.
if [[ -z "${tts_language}" || "${tts_language}" == "auto" ]]; then
    case "${tts_model}" in
        pocket_tts_english_*) tts_language="en" ;;
        pocket_tts_german_*) tts_language="de" ;;
        pocket_tts_french_*) tts_language="fr" ;;
        pocket_tts_italian_*) tts_language="it" ;;
        pocket_tts_portuguese_*) tts_language="pt" ;;
        pocket_tts_spanish_*) tts_language="es" ;;
        *) tts_language="en" ;;
    esac
fi

# The bridge needs a voice embedding for the model. Models that do not ship
# one get the voices of their language downloaded, so the synthesis works
# right away.
/usr/local/bin/ensure_tts_voices.sh "${tts_model}" "${tts_voice}" || \
    bashio::log.warning "No voice '${tts_voice}' is available for the model '${tts_model}'. The synthesis may fail."

target_dir=""
for candidate in "${SPEC_DIR}"/*.json; do
    if jq -e --arg id "${tts_model}" '.packages[]? | select(.id == $id)' "${candidate}" > /dev/null 2>&1; then
        target_dir="$(jq -r --arg id "${tts_model}" '.packages[] | select(.id == $id) | .target_directory' "${candidate}")"
        break
    fi
done

voice_file=""
if [[ -n "${target_dir}" ]]; then
    for candidate in "${MODELS_DIR}/${target_dir}"/embeddings/*.safetensors; do
        [[ -e "${candidate}" ]] || continue
        if [[ "$(basename "${candidate}" .safetensors)" == "${tts_voice,,}" ]]; then
            voice_file="${candidate}"
            break
        fi
    done
fi

jq -n \
    --arg uri "http://127.0.0.1:${APP_PORT}" \
    --arg tts_uri "tcp://0.0.0.0:${TTS_PORT}" \
    --arg model "${tts_model}" \
    --arg voice "${tts_voice}" \
    --arg language "${tts_language}" \
    --arg embedding "${voice_file}" \
    '{
        audiocpp_uri: $uri,
        log_level: "INFO",
        tts_uri: $tts_uri,
        tts_voices: [
            ({ model: $model, name: $voice, language: $language }
             + (if $embedding == "" then {} else { options: { voice_embedding_file: $embedding } } end))
        ]
    }' > "${CONFIG_DIR}/wyoming_tts.json"

bashio::log.info "Starting the Wyoming TTS bridge on port ${TTS_PORT}"
# Unbuffered, so the log shows up right away.
exec /opt/wyoming/bin/python -u -m wyoming_audiocpp_tts \
    --config "${CONFIG_DIR}/wyoming_tts.json" \
    --tts-uri "tcp://0.0.0.0:${TTS_PORT}"
