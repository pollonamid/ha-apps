#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Wyoming text-to-speech bridge
# ==============================================================================
# The bridge offers the voices of the whole model family, so Home Assistant
# can use every language of it. The model of a voice is downloaded when the
# voice is used for the first time, the proxy in front of audio.cpp does it.
# ==============================================================================
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
set -euo pipefail

readonly CONFIG_DIR="/config"
readonly MODELS_DIR="/share/audio_cpp/models"
readonly SPEC_DIR="/app/model_specs"
readonly TOKEN_FILE="/root/.cache/huggingface/token"
readonly APP_PORT="8099"
readonly PROXY_PORT="8098"
readonly TTS_PORT="11201"

export PYTHONPATH="/app/wyoming"

# bashio::config asks the Supervisor for the default of an empty option, which
# is not needed here.
option() {
    bashio::config "${1}" 2> /dev/null || true
}

tts_family="$(option 'tts_family')"
if [[ -z "${tts_family}" || "${tts_family}" == "null" ]]; then
    tts_family="pocket_tts"
fi

# Every voice of the family with its language, its model and the files that
# belong to it.
voices="$(/usr/local/bin/tts_family_voices.sh "${tts_family}")"
if [[ -z "${voices}" ]]; then
    bashio::log.warning "The family '${tts_family}' has no voices."
fi

# The name of a voice has to be unique, so the language is added to the voices
# that exist in more than one language.
jq_program='
    split("\n") | map(select(length > 0)) | map(split("|"))
    | map({name: .[0], language: .[1], model: .[2], embedding: .[4]}) as $voices
    | ($voices | group_by(.name) | map({key: .[0].name, value: length}) | from_entries) as $counts
    | $voices
    | map(.name = (if $counts[.name] > 1 then "\(.name) (\(.language))" else .name end))
'
voices_json="$(printf '%s' "${voices}" | jq -R -s "${jq_program}")"

config_program='
    {
        audiocpp_uri: $uri,
        log_level: "INFO",
        tts_uri: $tts_uri,
        tts_voices: (
            $voices
            | map({
                model: .model,
                name: .name,
                language: .language,
                options: { voice_embedding_file: .embedding }
              })
        )
    }
'
jq -n \
    --arg uri "http://127.0.0.1:${PROXY_PORT}" \
    --arg tts_uri "tcp://0.0.0.0:${TTS_PORT}" \
    --argjson voices "${voices_json}" \
    "${config_program}" > "${CONFIG_DIR}/wyoming_tts.json"

# The proxy installs the model of a voice when it is used for the first time.
repo="$(jq -r '.package_defaults.download.repo // empty' "${SPEC_DIR}/${tts_family}.json")"
revision="$(jq -r '.package_defaults.download.revision // "main"' "${SPEC_DIR}/${tts_family}.json")"

env \
    MODELS_DIR="${MODELS_DIR}" \
    TOKEN_FILE="${TOKEN_FILE}" \
    HF_REPO="${repo}" \
    HF_REVISION="${revision}" \
    LISTEN_HOST="127.0.0.1" \
    LISTEN_PORT="${PROXY_PORT}" \
    TARGET_HOST="127.0.0.1" \
    TARGET_PORT="${APP_PORT}" \
    /opt/wyoming/bin/python -u /usr/local/bin/model_proxy.py &

bashio::log.info "Starting the Wyoming TTS bridge on port ${TTS_PORT} with $(jq 'length' <<< "${voices_json}") voice(s)"
# Unbuffered, so the log shows up right away.
exec /opt/wyoming/bin/python -u -m wyoming_audiocpp_tts \
    --config "${CONFIG_DIR}/wyoming_tts.json" \
    --tts-uri "tcp://0.0.0.0:${TTS_PORT}"
