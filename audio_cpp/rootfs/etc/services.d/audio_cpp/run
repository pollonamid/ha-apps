#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Audio.cpp server
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
set -euo pipefail

readonly APP_DIR="/app"
readonly CONFIG_DIR="/config"
readonly MODELS_DIR="/share/audio_cpp/models"
readonly CUSTOM_DIR="${MODELS_DIR}/Custom"
readonly SPEC_DIR="/app/model_specs"
readonly PORT="8099"
readonly TOKEN_FILE="/root/.cache/huggingface/token"
readonly HF_BASE_URL="https://huggingface.co"

mkdir -p "${CONFIG_DIR}" "${MODELS_DIR}" "${CUSTOM_DIR}"

# Read an option from the local options file. bashio::config would ask the
# Supervisor for the default of an empty option, which is not needed here.
option() {
    bashio::config "${1}" 2> /dev/null || true
}

model="$(option 'model')"
tts_model="$(option 'tts_model')"
enable_tts="$(option 'enable_tts')"
backend="$(option 'backend')"
threads="$(option 'threads')"
max_loaded_models="$(option 'max_loaded_models')"
auto_install_model="$(option 'auto_install_model')"
hf_token="$(option 'hf_token')"
extra_models_json="$(option 'extra_models')"

# The token is stored in a file, because the server reads it from there for
# every download. That way it also works for the models the web interface
# installs, not only for the ones downloaded here.
if [[ -n "${hf_token}" ]]; then
    mkdir -p "$(dirname "${TOKEN_FILE}")"
    printf '%s' "${hf_token}" > "${TOKEN_FILE}"
    chmod 600 "${TOKEN_FILE}"
    bashio::log.info "Hugging Face token saved."
fi

# Keep the models inside /share so they survive an update. The server uses
# <binary directory>/models as its default models root.
if [[ ! -L /app/models ]]; then
    rm -rf /app/models
    ln -s "${MODELS_DIR}" /app/models
fi

# Find the model spec file that owns a model package id
resolve_spec() {
    local pkg="$1"
    local candidate
    for candidate in "${SPEC_DIR}"/*.json; do
        if jq -e --arg id "${pkg}" '.packages[]? | select(.id == $id)' "${candidate}" > /dev/null 2>&1; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

# Download the model when it is missing. Sets MODEL_FILE and MODEL_DIR.
MODEL_FILE=""
MODEL_DIR=""
install_model() {
    local pkg="$1"
    local spec_file
    local target_dir
    local gguf

    if ! spec_file="$(resolve_spec "${pkg}")"; then
        bashio::log.fatal "Unknown model '${pkg}'. Pick one of the models listed in the app options."
        exit 1
    fi

    target_dir="$(jq -r --arg id "${pkg}" '.packages[] | select(.id == $id) | .target_directory' "${spec_file}")"
    MODEL_DIR="${MODELS_DIR}/${target_dir}"
    gguf="$(find "${MODEL_DIR}" -maxdepth 1 -name '*.gguf' -print -quit 2> /dev/null || true)"

    if [[ -z "${gguf}" ]]; then
        if [[ "${auto_install_model}" != "true" ]]; then
            bashio::log.fatal "Model '${pkg}' is missing in ${MODELS_DIR} and the automatic download is disabled."
            exit 1
        fi
        bashio::log.info "Downloading model '${pkg}' into ${MODELS_DIR}. This can take a while."
        if ! "${APP_DIR}/audiocpp_model_manager" install "${pkg}" --models-dir "${MODELS_DIR}"; then
            # Hugging Face rejects public downloads with an invalid token, so
            # try again without it.
            if [[ -n "${hf_token}" && -f "${TOKEN_FILE}" ]]; then
                bashio::log.warning "The download failed, retrying without the Hugging Face token."
                mv "${TOKEN_FILE}" "${TOKEN_FILE}.disabled"
                if ! "${APP_DIR}/audiocpp_model_manager" install "${pkg}" --models-dir "${MODELS_DIR}"; then
                    mv "${TOKEN_FILE}.disabled" "${TOKEN_FILE}"
                    bashio::log.fatal "Could not download the model '${pkg}'."
                    exit 1
                fi
                mv "${TOKEN_FILE}.disabled" "${TOKEN_FILE}"
            else
                bashio::log.fatal "Could not download the model '${pkg}'."
                exit 1
            fi
        fi
        gguf="$(find "${MODEL_DIR}" -maxdepth 1 -name '*.gguf' -print -quit)"
    fi

    MODEL_FILE="${gguf}"
}

# Voice presets for models that ship voice embeddings, such as PocketTTS
voice_presets() {
    local dir="$1"
    local result='{}'
    local file
    local name
    shopt -s nullglob
    for file in "${dir}"/embeddings/*.safetensors; do
        name="$(basename "${file}" .safetensors)"
        result="$(jq --arg n "${name}" --arg p "${file}" '. + {($n): {options: {voice_embedding_file: $p}}}' <<< "${result}")"
    done
    shopt -u nullglob
    printf '%s' "${result}"
}

# Download a model from a Hugging Face URL. The URL must point to a file,
# a repository URL is resolved to its only .gguf file.
download_extra_model() {
    local url="$1"
    local destination="$2"
    local -a auth=()

    if [[ -n "${hf_token}" ]]; then
        auth=(-H "Authorization: Bearer ${hf_token}")
    fi

    if [[ "${url}" != *"://"* ]]; then
        url="${HF_BASE_URL}/${url#/}"
    fi

    if [[ "${url}" == *"/resolve/"* ]]; then
        if [[ -s "${destination}" ]]; then
            return 0
        fi
        bashio::log.info "Downloading ${url}"
        if ! curl -fsSL ${auth[@]+"${auth[@]}"} -o "${destination}.part" "${url}"; then
            rm -f "${destination}.part"
            if [[ ${#auth[@]} -gt 0 ]]; then
                # Hugging Face rejects public downloads with an invalid token,
                # so try again without it.
                bashio::log.warning "The download failed, retrying without the Hugging Face token."
                if curl -fsSL -o "${destination}.part" "${url}"; then
                    mv "${destination}.part" "${destination}"
                    return 0
                fi
                rm -f "${destination}.part"
            fi
            bashio::log.warning "Could not download ${url}"
            return 1
        fi
        mv "${destination}.part" "${destination}"
        return 0
    fi

    # A repository URL: find the only .gguf file in it
    local path="${url#*://*/}"
    local owner="${path%%/*}"
    local rest="${path#*/}"
    local repo="${owner}/${rest%%/*}"

    local listing
    if ! listing="$(curl -fsSL ${auth[@]+"${auth[@]}"} "${HF_BASE_URL}/api/models/${repo}")"; then
        bashio::log.warning "Could not read the repository ${repo}"
        return 1
    fi

    local file
    file="$(jq -r '[.siblings[]?.rfilename | select(endswith(".gguf"))] | if length == 1 then .[0] else empty end' <<< "${listing}")"
    if [[ -z "${file}" ]]; then
        bashio::log.warning "The repository ${repo} does not contain exactly one .gguf file. Use the full file URL instead."
        return 1
    fi

    download_extra_model "${url%/}/resolve/main/${file}" "${destination}"
}

# Models that were added by URL in the app configuration
custom_models='[]'
if [[ -n "${extra_models_json}" && "${extra_models_json}" != "null" ]]; then
    extra_count="$(jq 'length' <<< "${extra_models_json}" 2> /dev/null || echo 0)"
    for (( index = 0; index < extra_count; index++ )); do
        extra_family="$(jq -r --argjson i "${index}" '.[$i].family // empty' <<< "${extra_models_json}")"
        extra_task="$(jq -r --argjson i "${index}" '.[$i].task // empty' <<< "${extra_models_json}")"
        extra_url="$(jq -r --argjson i "${index}" '.[$i].url // empty' <<< "${extra_models_json}")"

        if [[ -z "${extra_family}" || -z "${extra_task}" || -z "${extra_url}" ]]; then
            continue
        fi

        file_name="${extra_url##*/}"
        extra_id="${file_name%.*}"
        extra_id="${extra_id//[^A-Za-z0-9._-]/_}"
        extra_path="${CUSTOM_DIR}/${file_name}"

        if [[ ! -s "${extra_path}" ]]; then
            if ! download_extra_model "${extra_url}" "${extra_path}"; then
                continue
            fi
        fi

        extra_spec=""
        if [[ -f "${SPEC_DIR}/${extra_family}.json" ]]; then
            extra_spec="${SPEC_DIR}/${extra_family}.json"
        fi

        custom_models="$(jq --arg id "${extra_id}" --arg family "${extra_family}" \
            --arg task "${extra_task}" --arg path "${extra_path}" \
            --arg spec "${extra_spec}" \
            '. + [{id: $id, family: $family, path: $path, task: $task, mode: "offline", lazy: true}
                  + (if $spec == "" then {} else {model_spec_override: $spec} end)]' <<< "${custom_models}")"
        bashio::log.info "Extra model ${extra_id} (${extra_family}) from ${extra_path}"
    done
fi

install_model "${model}"
asr_family="$(basename "$(resolve_spec "${model}")" .json)"
asr_path="${MODEL_FILE}"

use_tts="false"
tts_family=""
tts_path=""
tts_presets='{}'
if [[ "${enable_tts}" == "true" ]]; then
    install_model "${tts_model}"
    tts_family="$(basename "$(resolve_spec "${tts_model}")" .json)"
    tts_path="${MODEL_FILE}"
    tts_presets="$(voice_presets "${MODEL_DIR}")"
    use_tts="true"
fi

bashio::log.info "ASR model '${model}' (${asr_family}) from ${asr_path}"
if [[ "${use_tts}" == "true" ]]; then
    bashio::log.info "TTS model '${tts_model}' (${tts_family}) from ${tts_path}"
fi

# Fall back to the CPU backend when no Vulkan device is available
if [[ "${backend}" == "vulkan" ]]; then
    if ! "${APP_DIR}/audiocpp_server" --list-devices 2> /dev/null | grep -q '^vulkan:'; then
        bashio::log.warning "No Vulkan device found, falling back to the CPU backend."
        backend="cpu"
    fi
fi

jq -n \
    --arg host "0.0.0.0" \
    --argjson port "${PORT}" \
    --arg backend "${backend}" \
    --argjson threads "${threads}" \
    --argjson max_loaded "${max_loaded_models}" \
    --arg asr_id "${model}" \
    --arg asr_family "${asr_family}" \
    --arg asr_path "${asr_path}" \
    --arg tts_id "${tts_model}" \
    --arg tts_family "${tts_family}" \
    --arg tts_path "${tts_path}" \
    --argjson tts_presets "${tts_presets}" \
    --argjson use_tts "${use_tts}" \
    --argjson custom_models "${custom_models}" \
    '{
        host: $host,
        port: $port,
        backend: $backend,
        device: 0,
        threads: $threads,
        lazy_load: true,
        max_loaded_models: $max_loaded,
        ui: true,
        ui_management: true,
        models: (
            [{ id: $asr_id, family: $asr_family, path: $asr_path, task: "asr", mode: "offline", lazy: true }]
            + (if $use_tts then
                [({ id: $tts_id, family: $tts_family, path: $tts_path, task: "tts", mode: "offline", lazy: true }
                   + (if ($tts_presets | length) > 0
                      then { voice_presets: $tts_presets, default_voice_preset: ($tts_presets | keys[0]) }
                      else {} end))]
                else [] end)
            + $custom_models
        )
    }' > "${CONFIG_DIR}/server.json"

bashio::log.info "Starting audiocpp_server on port ${PORT} with the ${backend} backend."
exec "${APP_DIR}/audiocpp_server" \
    --config "${CONFIG_DIR}/server.json" \
    --model-spec-override "${SPEC_DIR}"
